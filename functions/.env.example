# Copy this file to `.env` and fill in real values to run the CLI harness locally.
# `.env` is gitignored — never commit real credentials.

# --- ScrapingBee (required to reach the Cloudflare-protected BOE site) ---
# Your API key from https://app.scrapingbee.com/account/manage.
SCRAPINGBEE_API_KEY=

# Which page-fetching provider the CLI/service uses. One of:
#   scrapingbee  - cloud browser that bypasses Cloudflare (production default)
#   direct       - plain fetch(); will be 403'd by the live BOE site, but useful
#                  for offline testing against saved sample HTML fixtures
PAGE_FETCHER=scrapingbee

# ScrapingBee proxy tier used to defeat Cloudflare. One of:
#   none     - datacenter proxy (cheapest, usually blocked here)
#   premium  - residential proxy (recommended starting point)
#   stealth  - stealth proxy pool (most robust, most expensive)
SCRAPINGBEE_PROXY_MODE=premium

# --- Vertex AI (for AI address parsing) ---
# The Google Cloud project and region for Vertex AI. When running inside a
# deployed Cloud Function these are inferred automatically; set them for local
# CLI runs. Authentication uses Application Default Credentials
# (`gcloud auth application-default login`) — no API key needed.
GCLOUD_PROJECT=vote-clt
VERTEX_LOCATION=us-central1
