{
  "name": "vote-clt-functions",
  "version": "0.1.0",
  "description": "Cloud Functions for Vote CLT — address ballot lookup via the Mecklenburg BOE",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lookup": "tsx cli/lookup.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.14.1",
    "cheerio": "^1.0.0",
    "firebase-functions": "^7.3.2",
    "genkit": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
