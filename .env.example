# Copy this file to `.env` for local development. `.env` is gitignored.

# Where the browser sends address lookups. In production this is unset and the
# site uses the same-origin Firebase Hosting rewrite /api/lookupAddress (see
# firebase.json). `astro dev` has no such rewrite, so point it straight at the
# deployed callable function:
PUBLIC_LOOKUP_URL=https://us-central1-vote-clt.cloudfunctions.net/lookupAddress
