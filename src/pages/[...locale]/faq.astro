---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { faqs } from '../../data/team';
import { renderMarkdown } from '../../lib/markdown';
import { localePaths, pick, useTranslations, type Locale } from '../../i18n/utils';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

// Answers are Markdown in src/data/team.ts; render them to HTML here, at build.
const entries = faqs.map((faq) => ({
  question: pick(faq.question, locale),
  answerHtml: renderMarkdown(pick(faq.answer, locale)),
}));
---

<BaseLayout locale={locale} title={t('faq.title')}>
  <div class="wrap page-head">
    <h1>{t('faq.title')}</h1>
    <p class="page-lead">{t('faq.intro')}</p>
  </div>

  <section class="wrap list">
    {
      entries.map((entry) => (
        <details class="qa">
          <summary>{entry.question}</summary>
          <div class="answer" set:html={entry.answerHtml} />
        </details>
      ))
    }
  </section>
</BaseLayout>

<style>
  .list {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    max-width: 48rem;
  }

  .qa {
    border-bottom: 1px solid var(--vc-rule);
  }

  .qa summary {
    padding: 1.125rem 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .qa summary:hover {
    color: var(--vc-blue);
  }

  .answer {
    padding-bottom: 1.25rem;
    color: var(--vc-ink-muted);
  }

  /* The answer's markup comes from Markdown, so style its children globally. */
  .answer :global(p + p),
  .answer :global(ul),
  .answer :global(ol) {
    margin-top: 0.75rem;
  }

  .answer :global(ul),
  .answer :global(ol) {
    padding-left: 1.25rem;
  }

  .answer :global(a) {
    font-weight: 600;
  }
</style>
