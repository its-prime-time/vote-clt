---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, localizePath, useTranslations, type Locale } from '../../i18n/utils';
import { meckBoeUpcomingElectionsUrl } from '../../data/links';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

/**
 * Early voting banner. Early in-person voting for the 2026 general election
 * runs Oct 15–31, so the banner should come down after the 31st. Because the
 * site is static, the build-time check below only helps if we rebuild; the
 * small script at the bottom of the page also hides it in the browser once
 * the date has passed, so a forgotten deploy never shows stale news.
 * The cutoff is midnight Eastern time at the start of Nov 1.
 */
const earlyVotingEndsAt = '2026-11-01T00:00:00-04:00';
const showEarlyVoting = Date.now() < Date.parse(earlyVotingEndsAt);
---

<BaseLayout locale={locale} title={t('home.title')}>
  <section class="wrap hero">
    {
      showEarlyVoting && (
        <p class="early-voting" data-ends-at={earlyVotingEndsAt}>
          {t('home.earlyVoting')}{' '}
          <a href={meckBoeUpcomingElectionsUrl} target="_blank" rel="noopener">
            {t('home.earlyVotingLink')}
          </a>
        </p>
      )
    }
    <h1>{t('home.title')}</h1>
    <p class="page-lead">{t('home.subtitle')}</p>

    <form class="search" action={localizePath('/my-ballot/results', locale)} method="get">
      <label class="visually-hidden" for="address">{t('home.addressLabel')}</label>
      <input
        id="address"
        name="address"
        type="text"
        autocomplete="street-address"
        placeholder={t('home.addressPlaceholder')}
        required
      />
      <button type="submit" class="go" aria-label={t('home.search')}>
        {/* Right arrow, drawn inline so it inherits the button's white color. */}
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 12h15" />
          <path d="M13 6l6 6-6 6" />
        </svg>
      </button>
    </form>

    <p class="manual">
      {t('home.manualPrefix')}<a href={localizePath('/candidates/north-carolina', locale)}
        >{t('home.manualLink')}</a
      >{t('home.manualSuffix')}
    </p>
  </section>
</BaseLayout>

<script>
  // Hide the early voting banner once its end date has passed (see the
  // comment on earlyVotingEndsAt in the frontmatter).
  const banner = document.querySelector<HTMLElement>('.early-voting');
  if (banner && Date.now() >= Date.parse(banner.dataset.endsAt ?? '')) {
    banner.hidden = true;
  }
</script>

<style>
  /* Early voting banner: a centered blue strip above the heading. */
  .early-voting {
    max-width: 39rem;
    margin: 0 auto clamp(1.5rem, 4vw, 2.5rem);
    padding: 0.85rem 1.25rem;
    border-radius: 0.5rem;
    background: var(--vc-blue);
    color: #fff;
    text-align: center;
    text-wrap: balance;
  }

  .early-voting a {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
  }

  .early-voting a:hover {
    text-decoration-thickness: 2px;
  }

  .hero {
    padding-block: clamp(3rem, 9vw, 7rem) clamp(3rem, 10vw, 9rem);
  }

  .search {
    position: relative;
    margin: clamp(2rem, 5vw, 3.5rem) auto 0;
    max-width: 39rem;
  }

  .search input {
    width: 100%;
    font: inherit;
    font-size: 1.0625rem;
    /* Extra right padding keeps typed text clear of the round submit button. */
    padding: 1rem 4rem 1rem 1.5rem;
    border: 1px solid var(--vc-ink-muted);
    border-radius: 999px;
    background: #fff;
    color: var(--vc-ink);
  }

  /* Round submit button sitting on the right edge of the pill. */
  .go {
    position: absolute;
    top: 50%;
    right: 0.45rem;
    transform: translateY(-50%);
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: var(--vc-blue);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .go:hover {
    background: var(--vc-blue-dark);
  }

  .search input::placeholder {
    color: var(--vc-ink-muted);
  }

  .search input:hover {
    border-color: var(--vc-blue);
  }

  .manual {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--vc-ink-muted);
    max-width: 32rem;
    margin-inline: auto;
    text-wrap: balance;
  }
</style>
