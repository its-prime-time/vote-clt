---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, localizePath, useTranslations, type Locale } from '../../i18n/utils';
import { meckBoeUpcomingElectionsUrl } from '../../data/links';
import { EARLY_VOTING_BANNER_ENDS_AT, POLLS_CLOSE_AT, POLLS_OPEN_AT } from '../../lib/electionBanner';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

/**
 * Election banner. It has three messages: the early voting notice until
 * 9 p.m. Eastern on Oct 31, then a live countdown to polls opening at
 * 6:30 a.m. on Nov 3, then "It's Election Day!" until polls close at
 * 7:30 p.m., after which it disappears. The dates and the timing rules live
 * in src/lib/electionBanner.ts.
 *
 * Because the site is static, the build-time check below only drops the
 * banner if we rebuild after polls close. So all three messages are rendered
 * (hidden and collapsed), and the client script at the bottom of the page
 * picks the right one from the visitor's clock and slides the banner open —
 * a forgotten deploy never shows stale news.
 */
const showBanner = Date.now() < Date.parse(POLLS_CLOSE_AT);
---

<BaseLayout locale={locale} title={t('home.title')}>
  {
    /*
     * Full-width strip directly under the site navigation (it is the first
     * thing inside <main>). The outer div does the collapse/expand animation;
     * the inner .wrap keeps the text in line with the rest of the page.
     */
    showBanner && (
      <div
        class="election-banner"
        data-early-ends-at={EARLY_VOTING_BANNER_ENDS_AT}
        data-polls-open-at={POLLS_OPEN_AT}
        data-polls-close-at={POLLS_CLOSE_AT}
      >
        <div class="election-banner-inner">
          <p class="wrap" data-phase="early" hidden>
            {t('home.earlyVoting')}{' '}
            <a href={meckBoeUpcomingElectionsUrl} target="_blank" rel="noopener">
              {t('home.earlyVotingLink')}
            </a>
          </p>
          <p class="wrap" data-phase="countdown" hidden>
            {t('home.countdownPrefix')}{' '}
            {/* role="timer" tells screen readers this changes constantly, so they don't announce every tick. */}
            <strong
              class="countdown"
              role="timer"
              data-day={t('home.countdownDay')}
              data-days={t('home.countdownDays')}
            />{' '}
            {t('home.countdownSuffix')}
          </p>
          <p class="wrap" data-phase="electionDay" hidden>
            {t('home.electionDay')}
          </p>
        </div>
      </div>
    )
  }
  <section class="wrap hero">
    <h1>{t('home.title')}</h1>
    <p class="page-lead">{t('home.subtitle')}</p>

    <form class="search" action={localizePath('/my-ballot/results', locale)} method="get">
      <label class="visually-hidden" for="address">{t('home.addressLabel')}</label>
      <input
        id="address"
        name="address"
        type="text"
        autocomplete="street-address"
        placeholder={t('home.addressPlaceholder')}
        required
      />
      <button type="submit" class="go" aria-label={t('home.search')}>
        {/* Right arrow, drawn inline so it inherits the button's white color. */}
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 12h15" />
          <path d="M13 6l6 6-6 6" />
        </svg>
      </button>
    </form>

    <p class="manual">
      {t('home.manualPrefix')}<a href={localizePath('/candidates/north-carolina', locale)}
        >{t('home.manualLink')}</a
      >{t('home.manualSuffix')}
    </p>
  </section>
</BaseLayout>

<script>
  // Drives the election banner (see the comment in the frontmatter and
  // src/lib/electionBanner.ts). Every second it works out which message
  // should show, updates the countdown, and opens or closes the banner.
  import { bannerPhase, formatTimeLeft, timeLeft, type BannerPhase } from '../../lib/electionBanner';

  const banner = document.querySelector<HTMLElement>('.election-banner');

  /** Show only the paragraph for `phase` (or none), and fill in the countdown. */
  function render(el: HTMLElement, phase: BannerPhase, now: number): void {
    for (const p of el.querySelectorAll<HTMLElement>('[data-phase]')) {
      p.hidden = p.dataset.phase !== phase;
    }
    if (phase === 'countdown') {
      const clock = el.querySelector<HTMLElement>('.countdown');
      if (clock) {
        const left = timeLeft(Date.parse(el.dataset.pollsOpenAt ?? '') - now);
        clock.textContent = formatTimeLeft(left, clock.dataset.day ?? '', clock.dataset.days ?? '');
      }
    }
    // Adding/removing the class runs the CSS slide-open / slide-closed transition.
    el.classList.toggle('is-shown', phase !== 'none');
  }

  /** Work out the phase for right now and render it. Returns the phase. */
  function update(el: HTMLElement): BannerPhase {
    const now = Date.now();
    const phase = bannerPhase(
      now,
      el.dataset.earlyEndsAt ?? '',
      el.dataset.pollsOpenAt ?? '',
      el.dataset.pollsCloseAt ?? '',
    );
    render(el, phase, now);
    return phase;
  }

  /** Start the banner after page load, then keep it current until it's gone. */
  function start(el: HTMLElement): void {
    // A short pause after load so the motion catches the eye rather than
    // happening while the page is still painting.
    window.setTimeout(() => {
      if (update(el) === 'none') return;
      const timer = window.setInterval(() => {
        if (update(el) === 'none') window.clearInterval(timer);
      }, 1000);
    }, 300);
  }

  if (banner) {
    if (document.readyState === 'complete') {
      start(banner);
    } else {
      window.addEventListener('load', () => start(banner), { once: true });
    }
  }
</script>

<style>
  /*
   * Election banner: a full-width red strip hugging the bottom of the
   * site navigation. It starts collapsed to zero height and slides open when
   * the script adds .is-shown. The grid-template-rows 0fr → 1fr trick lets
   * the height animate to the content's natural size, whatever the text wraps
   * to. Users who ask for reduced motion get it instantly (global.css).
   */
  .election-banner {
    display: grid;
    grid-template-rows: 0fr;
    background: var(--vc-red);
    color: #fff;
    transition: grid-template-rows 0.5s ease-out;
  }

  .election-banner.is-shown {
    grid-template-rows: 1fr;
  }

  /* The grid row clips this while collapsed. */
  .election-banner-inner {
    overflow: hidden;
  }

  /* The text fades and drops in slightly as the strip opens. */
  .election-banner p {
    /* Block margins only: .wrap centers the text with auto inline margins. */
    margin-block: 0;
    padding-block: 0.85rem;
    text-align: center;
    text-wrap: balance;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity 0.4s ease-out 0.15s,
      transform 0.4s ease-out 0.15s;
  }

  .election-banner.is-shown p {
    opacity: 1;
    transform: none;
  }

  /* The countdown digits keep a fixed width so the text doesn't jiggle each second. */
  .countdown {
    font-variant-numeric: tabular-nums;
  }

  .election-banner a {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
  }

  .election-banner a:hover {
    text-decoration-thickness: 2px;
  }

  .hero {
    padding-block: clamp(3rem, 9vw, 7rem) clamp(3rem, 10vw, 9rem);
  }

  .search {
    position: relative;
    margin: clamp(2rem, 5vw, 3.5rem) auto 0;
    max-width: 39rem;
  }

  .search input {
    width: 100%;
    font: inherit;
    font-size: 1.0625rem;
    /* Extra right padding keeps typed text clear of the round submit button. */
    padding: 1rem 4rem 1rem 1.5rem;
    border: 1px solid var(--vc-ink-muted);
    border-radius: 999px;
    background: #fff;
    color: var(--vc-ink);
  }

  /* Round submit button sitting on the right edge of the pill. */
  .go {
    position: absolute;
    top: 50%;
    right: 0.45rem;
    transform: translateY(-50%);
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: var(--vc-blue);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .go:hover {
    background: var(--vc-blue-dark);
  }

  .search input::placeholder {
    color: var(--vc-ink-muted);
  }

  .search input:hover {
    border-color: var(--vc-blue);
  }

  .manual {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--vc-ink-muted);
    max-width: 32rem;
    margin-inline: auto;
    text-wrap: balance;
  }
</style>
