---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, localizePath, useTranslations, type Locale } from '../../i18n/utils';
import { meckBoeUpcomingElectionsUrl } from '../../data/links';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

/**
 * Early voting banner. Early in-person voting for the 2026 general election
 * runs Oct 15–31, so the banner should come down after the 31st. Because the
 * site is static, the build-time check below only helps if we rebuild. The
 * banner is therefore rendered collapsed, and the small script at the bottom
 * of the page reveals it (with a slide-down animation) only while the date
 * hasn't passed, so a forgotten deploy never shows stale news.
 * The cutoff is midnight Eastern time at the start of Nov 1.
 */
const earlyVotingEndsAt = '2026-11-01T00:00:00-04:00';
const showEarlyVoting = Date.now() < Date.parse(earlyVotingEndsAt);
---

<BaseLayout locale={locale} title={t('home.title')}>
  {
    /*
     * Full-width strip directly under the site navigation (it is the first
     * thing inside <main>). The outer div does the collapse/expand animation;
     * the inner .wrap keeps the text in line with the rest of the page.
     */
    showEarlyVoting && (
      <div class="early-voting" data-ends-at={earlyVotingEndsAt}>
        <div class="early-voting-inner">
          <p class="wrap">
            {t('home.earlyVoting')}{' '}
            <a href={meckBoeUpcomingElectionsUrl} target="_blank" rel="noopener">
              {t('home.earlyVotingLink')}
            </a>
          </p>
        </div>
      </div>
    )
  }
  <section class="wrap hero">
    <h1>{t('home.title')}</h1>
    <p class="page-lead">{t('home.subtitle')}</p>

    <form class="search" action={localizePath('/my-ballot/results', locale)} method="get">
      <label class="visually-hidden" for="address">{t('home.addressLabel')}</label>
      <input
        id="address"
        name="address"
        type="text"
        autocomplete="street-address"
        placeholder={t('home.addressPlaceholder')}
        required
      />
      <button type="submit" class="go" aria-label={t('home.search')}>
        {/* Right arrow, drawn inline so it inherits the button's white color. */}
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 12h15" />
          <path d="M13 6l6 6-6 6" />
        </svg>
      </button>
    </form>

    <p class="manual">
      {t('home.manualPrefix')}<a href={localizePath('/candidates/north-carolina', locale)}
        >{t('home.manualLink')}</a
      >{t('home.manualSuffix')}
    </p>
  </section>
</BaseLayout>

<script>
  // Reveal the early voting banner after the page has loaded, unless its end
  // date has passed (see the comment on earlyVotingEndsAt in the
  // frontmatter). Adding the class starts the CSS slide-down transition.
  const banner = document.querySelector<HTMLElement>('.early-voting');

  function revealBanner(): void {
    if (!banner || Date.now() >= Date.parse(banner.dataset.endsAt ?? '')) return;
    // A short pause after load so the motion catches the eye rather than
    // happening while the page is still painting.
    window.setTimeout(() => banner.classList.add('is-shown'), 300);
  }

  if (document.readyState === 'complete') {
    revealBanner();
  } else {
    window.addEventListener('load', revealBanner, { once: true });
  }
</script>

<style>
  /*
   * Early voting banner: a full-width red strip hugging the bottom of the
   * site navigation. It starts collapsed to zero height and slides open when
   * the script adds .is-shown. The grid-template-rows 0fr → 1fr trick lets
   * the height animate to the content's natural size, whatever the text wraps
   * to. Users who ask for reduced motion get it instantly (global.css).
   */
  .early-voting {
    display: grid;
    grid-template-rows: 0fr;
    background: var(--vc-red);
    color: #fff;
    transition: grid-template-rows 0.5s ease-out;
  }

  .early-voting.is-shown {
    grid-template-rows: 1fr;
  }

  /* The grid row clips this while collapsed. */
  .early-voting-inner {
    overflow: hidden;
  }

  /* The text fades and drops in slightly as the strip opens. */
  .early-voting p {
    /* Block margins only: .wrap centers the text with auto inline margins. */
    margin-block: 0;
    padding-block: 0.85rem;
    text-align: center;
    text-wrap: balance;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity 0.4s ease-out 0.15s,
      transform 0.4s ease-out 0.15s;
  }

  .early-voting.is-shown p {
    opacity: 1;
    transform: none;
  }

  .early-voting a {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
  }

  .early-voting a:hover {
    text-decoration-thickness: 2px;
  }

  .hero {
    padding-block: clamp(3rem, 9vw, 7rem) clamp(3rem, 10vw, 9rem);
  }

  .search {
    position: relative;
    margin: clamp(2rem, 5vw, 3.5rem) auto 0;
    max-width: 39rem;
  }

  .search input {
    width: 100%;
    font: inherit;
    font-size: 1.0625rem;
    /* Extra right padding keeps typed text clear of the round submit button. */
    padding: 1rem 4rem 1rem 1.5rem;
    border: 1px solid var(--vc-ink-muted);
    border-radius: 999px;
    background: #fff;
    color: var(--vc-ink);
  }

  /* Round submit button sitting on the right edge of the pill. */
  .go {
    position: absolute;
    top: 50%;
    right: 0.45rem;
    transform: translateY(-50%);
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: var(--vc-blue);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .go:hover {
    background: var(--vc-blue-dark);
  }

  .search input::placeholder {
    color: var(--vc-ink-muted);
  }

  .search input:hover {
    border-color: var(--vc-blue);
  }

  .manual {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--vc-ink-muted);
    max-width: 32rem;
    margin-inline: auto;
    text-wrap: balance;
  }
</style>
