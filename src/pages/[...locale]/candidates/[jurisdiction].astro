---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CandidateCard from '../../../components/CandidateCard.astro';
import { jurisdictions, type Jurisdiction } from '../../../data/jurisdictions';
import { officeGroupsFor, officeTitle } from '../../../data/candidates';
import { defaultLocale, locales, pick, useTranslations, type Locale } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    jurisdictions.map((jurisdiction) => ({
      params: {
        locale: locale === defaultLocale ? undefined : locale,
        jurisdiction: jurisdiction.slug,
      },
      props: { locale, jurisdiction },
    })),
  );
}

const { locale, jurisdiction } = Astro.props as {
  locale: Locale;
  jurisdiction: Jurisdiction;
};
const t = useTranslations(locale);

const title = pick(jurisdiction.title, locale);
const subtitle = pick(jurisdiction.subtitle, locale);

// One section per office, generated from the ingested spreadsheet data.
const groups = officeGroupsFor(jurisdiction.slug);
---

<BaseLayout locale={locale} title={title} description={subtitle}>
  <div class="wrap page-head">
    <h1>{title}</h1>
    <p class="page-lead">{subtitle}</p>
  </div>

  {
    groups.length === 0 && (
      <p class="wrap empty">
        {jurisdiction.emptyNote ? pick(jurisdiction.emptyNote, locale) : t('candidates.noContests')}
      </p>
    )
  }

  {
    groups.map((group) => (
      <section class="wrap race" aria-labelledby={`race-${group.office}`}>
        <h2 id={`race-${group.office}`} class="rule-heading">
          {officeTitle(group.office, locale)}
        </h2>

        <div class="grid">
          {group.candidacies.map(({ candidate, contest }) => (
            <CandidateCard candidate={candidate} contest={contest} locale={locale} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .race {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .empty {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
    color: var(--vc-ink-muted);
    font-style: italic;
    max-width: 46rem;
  }
</style>
