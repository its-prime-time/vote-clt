---
/**
 * Stand-in for a photo that hasn't been supplied yet. Renders the sky/hill
 * graphic used in the mockup, scaled to fill whatever box it's dropped into.
 *
 * Swap a real <img> in wherever a `photo` field is set on the data record.
 */
interface Props {
  /** Accessible label. Omit to mark the graphic decorative. */
  label?: string;
  class?: string;
}

const { label, class: className } = Astro.props;
const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { role: 'presentation', 'aria-hidden': 'true' };
---

<svg
  class:list={['placeholder', className]}
  viewBox="0 0 100 100"
  preserveAspectRatio="xMidYMid slice"
  {...a11y}
>
  <defs>
    <linearGradient id="ph-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#cfe7f7"></stop>
      <stop offset="100%" stop-color="#eaf4fb"></stop>
    </linearGradient>
  </defs>
  <rect width="100" height="100" fill="url(#ph-sky)"></rect>
  <g fill="#fff">
    <rect x="34" y="30" width="32" height="9" rx="4.5"></rect>
    <circle cx="42" cy="30" r="7"></circle>
    <circle cx="56" cy="27.5" r="9.5"></circle>
  </g>
  <path d="M0 72 Q 30 60 55 70 T 100 66 L100 100 L0 100 Z" fill="#a8cf4a"></path>
  <path d="M0 82 Q 32 70 58 80 T 100 78 L100 100 L0 100 Z" fill="#6f9d17"></path>
</svg>

<style>
  .placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: #eaf4fb;
  }
</style>
