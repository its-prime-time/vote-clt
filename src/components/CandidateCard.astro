---
import Placeholder from './Placeholder.astro';
import { issuesFor, partyAbbreviation, type Candidate, type Contest } from '../data/candidates';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  candidate: Candidate;
  contest: Contest;
  locale: Locale;
}

const { candidate, contest, locale } = Astro.props;
const t = useTranslations(locale);

const abbreviation = partyAbbreviation[candidate.party];
const displayName = abbreviation ? `${candidate.name} (${abbreviation})` : candidate.name;

// The coloured band over the photo says which seat this card is for. A
// countywide, single-seat contest (Sheriff) has nothing to say and gets no band.
const bandParts: string[] = [];
if (contest.atLarge) bandParts.push(t('candidates.atLarge'));
if (contest.district) bandParts.push(`${t('candidates.district')} ${contest.district}`);
if (contest.seat) bandParts.push(`${t('candidates.seat')} ${contest.seat}`);
if (contest.voteFor > 1) bandParts.push(`${t('candidates.voteFor')} ${contest.voteFor}`);
const band = bandParts.join(' · ');

const issues = issuesFor(candidate, locale);
---

<article class="card">
  <div class="photo">
    {
      candidate.photo ? (
        <img src={candidate.photo.path} alt={candidate.name} width="480" height="600" loading="lazy" />
      ) : (
        <Placeholder />
      )
    }
    {band && <p class:list={['band', `party-${candidate.party}`]}>{band}</p>}
  </div>

  <h3 class="name">{displayName}</h3>

  {
    issues.length > 0 ? (
      <ul class="issues">
        {issues.map((issue) => (
          <li>{issue}</li>
        ))}
      </ul>
    ) : (
      <p class="issues no-data">{t('candidates.noData')}</p>
    )
  }

  {
    candidate.website && (
      <p class="website">
        <a href={candidate.website} rel="noopener" target="_blank">
          {t('candidates.website')}
        </a>
      </p>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--vc-surface-alt);
    overflow: hidden;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Colored band across the bottom of the photo, per the mockup. */
  .band {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    margin: 0;
    padding: 0.25rem 0.5rem;
    background: var(--vc-gray-party);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
  }

  .party-DEM {
    background: var(--vc-blue);
  }
  .party-REP {
    background: var(--vc-red);
  }

  .name {
    margin-top: 0.6rem;
    font-size: 1.0625rem;
    font-weight: 500;
    text-align: center;
    letter-spacing: 0;
  }

  .issues {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    text-align: center;
    font-size: 0.875rem;
    color: var(--vc-ink-muted);
    text-wrap: balance;
  }

  .issues li::before {
    content: '- ';
  }

  .no-data {
    font-style: italic;
  }

  .website {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.8125rem;
  }
</style>
