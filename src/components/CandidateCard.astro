---
/**
 * One candidate. Two looks:
 *
 *   variant="grid"    (default) the All Candidates pages — band shows the
 *                     district/seat, blurb as bullet lines.
 *   variant="ballot"  the sample-ballot page — band shows the jurisdiction
 *                     ("NORTH CAROLINA"), bold name, blurb as one sentence.
 */
import Placeholder from './Placeholder.astro';
import { issuesFor, issuesLocale, partyAbbreviation, type Candidate, type Contest } from '../data/candidates';
import { getJurisdiction } from '../data/jurisdictions';
import { blurbSentence } from '../lib/blurb';
import { pick, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  candidate: Candidate;
  contest: Contest;
  locale: Locale;
  variant?: 'grid' | 'ballot';
}

const { candidate, contest, locale, variant = 'grid' } = Astro.props;
const t = useTranslations(locale);

const abbreviation = partyAbbreviation[candidate.party];
const displayName = abbreviation ? `${candidate.name} (${abbreviation})` : candidate.name;

// The coloured band over the photo.
let band: string | null;
if (variant === 'ballot') {
  // On the ballot the district is already in the heading's pill, so the band
  // names who elects this seat, per the mockup ("NORTH CAROLINA").
  const jurisdiction = getJurisdiction(contest.jurisdiction);
  band = jurisdiction ? pick(jurisdiction.title, locale) : null;
} else {
  // On the grid it says which seat this card is for. A countywide, single-seat
  // contest (Sheriff) has nothing to say and gets no band.
  const parts: string[] = [];
  if (contest.atLarge) parts.push(t('candidates.atLarge'));
  if (contest.district) parts.push(`${t('candidates.district')} ${contest.district}`);
  if (contest.seat) parts.push(`${t('candidates.seat')} ${contest.seat}`);
  if (contest.voteFor > 1) parts.push(`${t('candidates.voteFor')} ${contest.voteFor}`);
  band = parts.length > 0 ? parts.join(' · ') : null;
}

const issues = issuesFor(candidate, locale);

// The sentence is built in the language the blurb actually exists in, so an
// English blurb on the Spanish page reads as an English sentence rather than
// "Prioriza lowering costs … y protecting jobs".
const blurbLocale = issuesLocale(candidate, locale);
const sentence =
  variant === 'ballot'
    ? blurbSentence(issues, useTranslations(blurbLocale)('ballot.prioritizes'), blurbLocale)
    : null;
---

<article class:list={['card', variant]}>
  <div class="photo">
    {
      candidate.photo ? (
        <img src={candidate.photo.path} alt={candidate.name} width="480" height="600" loading="lazy" />
      ) : (
        <Placeholder />
      )
    }
    {band && <p class:list={['band', `party-${candidate.party}`]}>{band}</p>}
  </div>

  {/* The name links to the campaign site when the profile has one. */}
  <h3 class="name">
    {
      candidate.website ? (
        <a href={candidate.website} rel="noopener" target="_blank">
          {displayName}
        </a>
      ) : (
        displayName
      )
    }
  </h3>

  {
    variant === 'ballot' ? (
      sentence ? (
        <p class="sentence">{sentence}</p>
      ) : (
        <p class="sentence no-data">{t('candidates.noData')}</p>
      )
    ) : issues.length > 0 ? (
      <ul class="issues">
        {issues.map((issue) => (
          <li>{issue}</li>
        ))}
      </ul>
    ) : (
      <p class="issues no-data">{t('candidates.noData')}</p>
    )
  }

</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--vc-surface-alt);
    overflow: hidden;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Colored band across the bottom of the photo, per the mockup. */
  .band {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    margin: 0;
    padding: 0.25rem 0.5rem;
    background: var(--vc-gray-party);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
  }

  .party-DEM {
    background: var(--vc-blue);
  }
  .party-REP {
    background: var(--vc-red);
  }
  .party-LIB {
    background: var(--vc-gold);
  }
  .party-GRE {
    background: var(--vc-green);
  }

  .name {
    margin-top: 0.6rem;
    font-size: 1.0625rem;
    font-weight: 500;
    text-align: center;
    letter-spacing: 0;
  }

  .ballot .name {
    font-weight: 700;
    font-size: 1.125rem;
  }

  .issues {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    text-align: center;
    font-size: 0.875rem;
    color: var(--vc-ink-muted);
    text-wrap: balance;
  }

  .issues li::before {
    content: '- ';
  }

  .sentence {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--vc-ink);
    text-wrap: pretty;
  }

  .name a {
    color: var(--vc-blue);
    text-decoration: underline;
  }

  .name a:hover {
    color: var(--vc-blue-dark);
  }

  .no-data {
    font-style: italic;
    color: var(--vc-ink-muted);
  }
</style>
